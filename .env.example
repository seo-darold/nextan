# Скопируйте в .env и заполните значения. Файл .env не коммитить в git.

# Google OAuth 2.0
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...

# VK ID (обязательно для входа через VK — без этого будет «VK ID не настроен»)
# Защищённый ключ из кабинета приложения VK: https://id.vk.com/about/business/developers
VK_CLIENT_SECRET=ваш_защищённый_ключ

# По желанию (есть значения по умолчанию):
# VK_APP_ID=54440895
# VK_AUTH_REDIRECT_URL=https://nextanalytics.ru/auth/vk-id-callback/
