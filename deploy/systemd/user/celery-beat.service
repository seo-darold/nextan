[Unit]
Description=Celery Beat — Nextan (user)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/user/nextan
Environment="PATH=/home/user/nextan/env/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DJANGO_SETTINGS_MODULE=config.settings"
ExecStart=/home/user/nextan/env/bin/celery -A config beat -l info
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
